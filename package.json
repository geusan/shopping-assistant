{
  "name": "fits-shopping-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "build": "pnpm typecheck && pnpm build:extension && pnpm build:web && pnpm build:api",
    "build:web": "vite build",
    "build:api": "node scripts/build-api.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "start": "node dist/api/server.mjs"
  },
  "dependencies": {
    "@hono/node-server": "latest",
    "dotenv": "latest",
    "hono": "4.13.17",
    "lucide-react": "latest",
    "openai": "7.53.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/chrome": "latest",
    "@types/node": "^22.0.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "6.2.1",
    "esbuild": "latest",
    "jsdom": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@10.30.1+sha512.3590e550d5384caa39bd5c7c739f72270234b2f6059e13018f975c313b1eb9fefcc09714048765d4d9efe961382c312e624572c0420762bdc5d5940cdf9be73a"
}
